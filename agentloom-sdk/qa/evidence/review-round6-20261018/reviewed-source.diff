+
+async def test_mode_instructions_are_charged_to_context_budget(runtime_store, build):
+    async with RuntimeEngine(store=runtime_store) as runtime:
+        model = ScriptedModel(
+            lambda r: pytest.fail("Oversized fixed prompt must not dispatch"),
+            context_window_tokens=1200,
+            max_output_tokens=256,
+        )
+        agent = build(runtime, None, model=model)
+        assert (
+            estimate([{"role": "system", "content": "SYSTEM"}, {"role": "user", "content": "go"}])
+            < agent.budget.input
+        )
+        result = await agent.ainvoke("go")
+        assert (
+            result.status == "failed"
+            and result.error["code"] == "CONTEXT_PROTECTED_INPUT_TOO_LARGE"
+        )
+        assert result.usage.business_model_attempts == result.usage.compaction_model_attempts == 0
diff --git a/agentloom-sdk/tests/test_prompt_recovery.py b/agentloom-sdk/tests/test_prompt_recovery.py
new file mode 100644
index 0000000..1d65de9
--- /dev/null
+++ b/agentloom-sdk/tests/test_prompt_recovery.py
@@ -0,0 +1,208 @@
+"""Instruction snapshots survive restart, including roles not yet instantiated."""
+
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from agentloom import (
+    AgentDefinition,
+    InfrastructureError,
+    LocalEnvironment,
+    ModelResponse,
+    PlanAgent,
+    RuntimeEngine,
+    ToolCall,
+)
+from agentloom.prompts import templates
+from agentloom.prompts.assembly import PROMPT_RECORD_KIND
+from agentloom.runtime.recovery import validate_recovery
+
+
+class Crash(Exception):
+    pass
+
+
+@pytest.mark.parametrize("cut", ["before_root", "before_child"])
+def test_real_process_exit_and_template_upgrade(tmp_path, cut):
+    worker = Path(__file__).parent / "support" / "prompt_process.py"
+    env = {**os.environ, "PYTHONPATH": str(Path(__file__).parents[1] / "src")}
+    first = subprocess.run(
+        [sys.executable, str(worker), str(tmp_path), cut],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    assert first.returncode == 75, first.stderr
+    time.sleep(0.35)
+    second = subprocess.run(
+        [sys.executable, str(worker), str(tmp_path), "resume"],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    assert second.returncode == 0, second.stderr
+    assert not second.stderr, "Shutdown must retrieve all maintenance task outcomes"
+    assert json.loads(second.stdout) == {"status": "succeeded", "loops": 3}
+    audit = [json.loads(line) for line in (tmp_path / "audit.jsonl").read_text().splitlines()]
+    assert [entry["role"] for entry in audit] == ["planner", "worker", "planner"]
+    assert "Mode: Plan." in audit[0]["instructions"]
+    assert "Mode: Executor." in audit[1]["instructions"]
+    assert audit[0]["instructions"] == audit[2]["instructions"]
+
+
+def plan_options():
+    return dict(
+        cls=PlanAgent,
+        definition=AgentDefinition("p", "整理报告。"),
+        executors={"worker": AgentDefinition("w", "提取事实。", "提取事实")},
+    )
+
+
+def response(request):
+    if request.role_key == "planner" and not any(m["role"] == "tool" for m in request.messages):
+        return ModelResponse(
+            tool_calls=(ToolCall("delegate_task", {"executor": "worker", "task": "提取数字"}),)
+        )
+    return ModelResponse("done")
+
+
+@pytest.mark.parametrize("cut", ["environment:", "decision:"])
+async def test_upgrade_uses_admission_snapshot_for_new_root_and_child(
+    runtime_store, build, monkeypatch, cut
+):
+    def checkpoint(command, state):
+        if command.startswith(cut):
+            raise Crash()
+
+    async with RuntimeEngine(store=runtime_store, checkpoint_callback=checkpoint) as initial:
+        agent = build(initial, response, **plan_options())
+        handle = await agent.start("报告", run_id="frozen")
+        with pytest.raises(InfrastructureError):
+            await handle.wait(timeout_s=3)
+        saved = initial._load("frozen")["prompt_contract"]
+        first_calls = len(agent.model.requests)
+
+    monkeypatch.setattr(templates, "COMMON", "NEW SDK TEMPLATE")
+    monkeypatch.setattr(templates, "TEMPLATE_VERSION", "future-template")
+    async with RuntimeEngine(store=runtime_store) as recovered:
+        agent = build(recovered, response, **plan_options())
+        result = await agent.ainvoke(run_id="frozen")
+        assert result.status == "succeeded"
+        assert len(agent.model.requests) + first_calls == 3
+        for request in agent.model.requests:
+            assert request.messages[1]["content"] == saved["roles"][request.role_key]["content"]
+            assert "NEW SDK TEMPLATE" not in request.messages[1]["content"]
+        state = recovered._load("frozen")
+        assert state["prompt_contract"] == saved
+        validate_recovery(state)
+        new_agent = build(recovered, response, **plan_options())
+        new_result = await new_agent.ainvoke("新报告")
+        assert new_result.status == "succeeded"
+        assert all("NEW SDK TEMPLATE" in r.messages[1]["content"] for r in new_agent.model.requests)
+
+
+async def test_legacy_run_keeps_old_layout_for_later_executor(runtime_store, build):
+    def checkpoint(command, state):
+        if command == "initialize":
+            raise Crash()
+
+    async with RuntimeEngine(store=runtime_store, checkpoint_callback=checkpoint) as initial:
+        handle = await build(initial, response, **plan_options()).start("报告", run_id="legacy")
+        with pytest.raises(InfrastructureError):
+            await handle.wait(timeout_s=3)
+    with runtime_store.transaction("default") as tx:
+        state = tx.get("runs", "legacy")
+        del state["prompt_contract"]
+        context = state["tasks"][state["root_task_id"]]["context"]
+        context["records"] = [r for r in context["records"] if r["kind"] != PROMPT_RECORD_KIND]
+        context["revision"] = len(context["records"])
+        for seq, record in enumerate(context["records"], 1):
+            record["context_seq"] = seq
+        tx.put("runs", "legacy", state)
+    async with RuntimeEngine(store=runtime_store) as recovered:
+        agent = build(recovered, response, **plan_options())
+        assert (await agent.ainvoke(run_id="legacy")).status == "succeeded"
+        assert len(agent.model.requests) == 3
+        assert all(
+            len([m for m in r.messages if m["role"] == "system"]) == 1 for r in agent.model.requests
+        )
+        state = recovered._load("legacy")
+        assert "prompt_contract" not in state
+        validate_recovery(state)
+
+
+@pytest.mark.parametrize(
+    "corruption",
+    [
+        "contract",
+        "version",
+        "roles",
+        "profile",
+        "text",
+        "record",
+        "flags",
+        "position",
+        "summary",
+        "request",
+    ],
+)
+async def test_prompt_corruption_fails_before_dispatch(runtime_store, build, corruption):
+    def checkpoint(command, state):
+        if command.startswith("begin:"):
+            raise Crash()
+
+    async with RuntimeEngine(store=runtime_store, checkpoint_callback=checkpoint) as initial:
+        handle = await build(initial, lambda r: pytest.fail("cut precedes dispatch")).start(
+            "go", run_id="corrupt-prompt"
+        )
+        with pytest.raises(InfrastructureError):
+            await handle.wait(timeout_s=3)
+    with runtime_store.transaction("default") as tx:
+        state = tx.get("runs", "corrupt-prompt")
+        contract = state["prompt_contract"]
+        context = state["tasks"][state["root_task_id"]]["context"]
+        sdk = context["records"][1]
+        if corruption == "contract":
+            state["prompt_contract"] = None
+        elif corruption == "version":
+            contract["schema_version"] = True
+        elif corruption == "roles":
+            contract["roles"] = {}
+        elif corruption == "profile":
+            contract["roles"]["react"]["profile"] = "planner"
+        elif corruption == "text":
+            sdk["message"]["content"] = "changed"
+        elif corruption == "record":
+            sdk["kind"] = "message"
+        elif corruption == "flags":
+            sdk["protected"] = False
+        elif corruption == "position":
+            context["records"][0], context["records"][1] = sdk, context["records"][0]
+            for seq, entry in enumerate(context["records"], 1):
+                entry["context_seq"] = seq
+        elif corruption == "summary":
+            context["snapshot"] = {"sources": {sdk["record_id"]: "ignored"}}
+        else:
+            next(iter(state["operations"].values()))["request"]["messages"][1]["content"] = (
+                "changed"
+            )
+        tx.put("runs", "corrupt-prompt", state)
+
+    class NoEnvironment(LocalEnvironment):
+        def prepare(self, *args, **kwargs):
+            pytest.fail("Prompt validation must precede environment preparation")
+
+    async with RuntimeEngine(store=runtime_store, environment=NoEnvironment()) as recovered:
+        agent = build(recovered, lambda r: pytest.fail("Corrupt prompt dispatched"))
+        handle = await agent.start(run_id="corrupt-prompt")
+        with pytest.raises(InfrastructureError, match="PERSISTENCE_INVARIANT_BROKEN") as error:
+            await handle.wait(timeout_s=3)
+        assert error.value.field_path.startswith("prompt_contract.")
+        assert not agent.model.requests
diff --git a/agentloom-sdk/tests/test_review_whitebox_probe.py b/agentloom-sdk/tests/test_review_whitebox_probe.py
new file mode 100644
index 0000000..61c1c11
--- /dev/null
+++ b/agentloom-sdk/tests/test_review_whitebox_probe.py
@@ -0,0 +1,987 @@
+"""White-box probes derived line-by-line from docs/sdk requirements and design.
+
+Each test names the document clause it probes. Nothing here duplicates an
+existing suite assertion on purpose: the target is a doc clause, not a line
+count. Workflow is explicitly out of scope for this release.
+"""
+
+import asyncio
+import json
+
+import pytest
+from conftest import binding, tool
+
+from agentloom import (
+    AgentDefinition,
+    AgentLoomError,
+    CapabilityBinding,
+    CapabilityRegistration,
+    CapabilityRegistry,
+    CapabilitySpec,
+    CapabilitySpec,
+    ContextPolicy,
+    ExecutionPolicy,
+    FunctionToolAdapter,
+    ModelDescriptor,
+    ModelOptions,
+    ModelResponse,
+    PlanAgent,
+    ProviderEvent,
+    RequestError,
+    RetryPolicy,
+    RuntimeEngine,
+    ScriptedModel,
+    ToolCall,
+    WorkspaceBinding,
+)
+
+def _tool_definition(name="assistant", prompt="SYSTEM", binding_key="echo", description=""):
+    return AgentDefinition(name, prompt, description, capabilities=(binding(binding_key),))
+
+
+def _one_tool_call_then_done(request, name="echo", arguments=None):
+    if [m for m in request.messages if m["role"] == "tool"]:
+        return ModelResponse("done")
+    return ModelResponse(tool_calls=(ToolCall(name, arguments or {}),))
+
+
+def writer_driver(request):
+    return _one_tool_call_then_done(request, "writer")
+
+
+def _constrained_tool(function, name="echo", schema=None):
+    """A registration whose arguments a Hook cannot freely rewrite."""
+    return CapabilityRegistration(
+        name,
+        FunctionToolAdapter(function),
+        (
+            CapabilitySpec(
+                name,
+                name,
+                name,
+                schema or {"type": "object", "properties": {"v": {"type": "integer", "maximum": 10}}},
+            ),
+        ),
+    )
+
+
+# ---------------------------------------------------------------- requirements §2
+
+
+def test_requirements_default_table_matches_sdk_defaults():
+    """requirements.md §2 default table, checked against the actual dataclasses."""
+    execution = ExecutionPolicy()
+    assert (execution.loop_max, execution.run_timeout_seconds) == (100, 3600)
+    assert execution.parallel_enabled is False
+    assert execution.executor_max_parallel == 2
+    assert execution.model_first_output_timeout_seconds == 60
+    assert execution.model_stream_idle_timeout_seconds is None
+    assert execution.tool_timeout_seconds == 10
+    assert execution.retry == RetryPolicy()
+    assert (execution.retry.enabled, execution.retry.max_attempts) == (False, 2)
+    assert execution.retry.delay_seconds == 2
+
+    context = ContextPolicy()
+    assert (context.recent_runs, context.trigger_ratio) == (2, 0.8)
+    assert context.output_reserve_tokens is None
+    assert context.safety_margin_tokens is None
+    assert context.summary_target_tokens is None
+    assert context.compaction_prompt_addendum == ""
+
+    # §2 upper bounds are input validation only.
+    for field, value in (
+        ("loop_max", 0),
+        ("loop_max", 100001),
+        ("run_timeout_seconds", 86401),
+        ("executor_max_parallel", 129),
+        ("model_first_output_timeout_seconds", 3601),
+        ("tool_timeout_seconds", 3601),
+        ("model_stream_idle_timeout_seconds", 3601),
+    ):
+        with pytest.raises(AgentLoomError):
+            ExecutionPolicy(**{field: value})
+    with pytest.raises(AgentLoomError):
+        RetryPolicy(max_attempts=21)
+    with pytest.raises(AgentLoomError):
+        RetryPolicy(delay_seconds=301)
+    with pytest.raises(AgentLoomError):
+        RetryPolicy(enabled="yes")
+    for field, value in (("recent_runs", 101), ("trigger_ratio", 1.0), ("trigger_ratio", 0.0)):
+        with pytest.raises(AgentLoomError):
+            ContextPolicy(**{field: value})
+
+
+def test_safety_margin_and_budget_derivation_matches_context_design(tmp_path):
+    """requirements.md §2: safety margin defaults to max(256, ceil(window * 1%))."""
+    from agentloom.context import ContextBudget
+
+    options = ModelOptions()
+    for window, safety in ((10_000, 256), (100_000, 1000), (1_000_000, 10_000)):
+        budget = ContextBudget.resolve(
+            ModelDescriptor("m", window, max_output_tokens=4096), ContextPolicy(), options
+        )
+        assert budget.safety == safety
+        assert budget.window == window
+        assert budget.output == min(4096, window // 4)
+        assert budget.input == window - budget.output - safety
+        assert budget.trigger == int(0.8 * budget.input)
+    # An explicit margin overrides the derivation; an over-large window fails early.
+    override = ContextBudget.resolve(
+        ModelDescriptor("m", 10_000), ContextPolicy(safety_margin_tokens=64), options
+    )
+    assert override.safety == 64
+    assert ScriptedModel(lambda r: ModelResponse("x"), context_window_tokens=1000).descriptor
+
+
+# ---------------------------------------------------------------- requirements §3
+
+
+@pytest.mark.parametrize("finish_at,expected", [(2, "succeeded"), (None, "budget_exhausted")])
+async def test_loop_limit_stops_before_an_extra_model_call(build, finish_at, expected):
+    """requirements.md §3: the Nth legal Loop may finish; N+1 returns LOOP_LIMIT_EXCEEDED
+    without an extra summarizing model call."""
+    limit, calls = 3, {"n": 0}
+
+    def responder(request):
+        calls["n"] += 1
+        if finish_at is not None and calls["n"] >= finish_at:
+            return ModelResponse("done")
+        return ModelResponse(tool_calls=(ToolCall("echo", {"v": calls["n"]}),))
+
+    async with RuntimeEngine() as runtime:
+        agent = build(
+            runtime,
+            responder,
+            definition=_tool_definition(),
+            capabilities=CapabilityRegistry(tools=(tool(lambda a, c: a["v"]),)),
+            execution_policy=ExecutionPolicy(loop_max=limit),
+        )
+        result = await (await agent.start("question")).wait(timeout_s=10)
+        state = runtime._load(result.run_id)
+        assert state["status"] == expected, state["error"]
+        if expected == "budget_exhausted":
+            assert state["error"]["code"] == "LOOP_LIMIT_EXCEEDED"
+            # The 101st-style call is refused before the model is asked again.
+            assert calls["n"] == limit
+            assert state["usage"]["loops_consumed"] == limit
+        else:
+            # The last legal Loop is allowed to finish and deliver its answer.
+            assert calls["n"] == finish_at and state["output"]["value"] == "done"
+
+
+async def test_planner_and_executors_share_one_root_loop_budget(build):
+    """requirements.md §2: loop_max belongs to the root ExecutionRecord and is shared
+    by the Planner and every Executor."""
+    seen = {"executor": 0, "planner": 0}
+
+    def responder(request):
+        if request.role_key == "planner":
+            seen["planner"] += 1
+            feedback = [m for m in request.messages if m["role"] == "tool"]
+            if not feedback:
+                return ModelResponse(
+                    tool_calls=(ToolCall("delegate_task", {"executor": "w", "task": "a"}),)
+                )
+            return ModelResponse("plan done")
+        seen["executor"] += 1
+        return ModelResponse("sub done")
+
+    async with RuntimeEngine() as runtime:
+        agent = build(
+            runtime,
+            responder,
+            cls=PlanAgent,
+            executors={"w": AgentDefinition("worker", "SUB", "carries out delegated work")},
+            execution_policy=ExecutionPolicy(loop_max=10),
+        )
+        result = await (await agent.start("question")).wait(timeout_s=10)
+        state = runtime._load(result.run_id)
+        assert state["status"] == "succeeded"
+        # 1 planner + 1 executor decision, plus the planner's post-batch decision.
+        assert state["usage"]["loops_consumed"] == seen["planner"] + seen["executor"] == 3
+        assert state["usage"]["business_model_attempts"] == 3
+
+
+async def test_retry_creates_a_new_attempt_under_one_operation(build):
+    """requirements.md §3: SDK retry is a new Attempt of the same Operation, not a
+    new logical model call."""
+    state = {"n": 0}
+
+    class Flaky:
+        def __init__(self, inner):
+            self.descriptor = inner.descriptor
+            self.inner = inner
+
+        async def stream_once(self, request, context):
+            state["n"] += 1
+            if state["n"] == 1:
+                yield ProviderEvent("text_delta", "partial")
+                raise AgentLoomError(
+                    "MODEL_STREAM_IDLE_TIMEOUT",
+                    category="timeout",
+                    phase="receive",
+                    external_outcome="unknown",
+                )
+            async for frame in self.inner.stream_once(request, context):
+                yield frame
+
+
+    async with RuntimeEngine() as runtime:
+        inner = ScriptedModel(lambda r: ModelResponse("recovered"))
+        model = Flaky(inner)
+        agent = build(
+            runtime,
+            None,
+            model=model,
+            execution_policy=ExecutionPolicy(
+                retry=RetryPolicy(enabled=True, max_attempts=2, delay_seconds=0)
+            ),
+        )
+        result = await (await agent.start("question")).wait(timeout_s=10)
+        run = runtime._load(result.run_id)
+        op = next(iter(run["operations"].values()))
+        assert result.status == "succeeded" and result.output.value == "recovered"
+        assert len(op["attempts"]) == 2 and op["attempts"][0]["status"] != "started"
+        # One accepted logical decision still consumes exactly one Loop ticket.
+        assert run["usage"]["loops_consumed"] == 1
+        assert run["usage"]["business_model_attempts"] == 2
+
+
+# ---------------------------------------------------------------- requirements §3 / runtime.md §5
+
+
+async def test_batch_feedback_is_delivered_once_in_call_order(build):
+    """runtime.md §5: batch input order never depends on completion order."""
+    order = []
+
+    latency = {1: 0.15, 2: 0.08, 3: 0.0}
+
+    async def slow_echo(arguments, context):
+        await asyncio.sleep(latency[arguments["v"]])
+        order.append(arguments["v"])
+        return f"r{arguments['v']}"
+
+    async with RuntimeEngine() as runtime:
+        seen_feedback = {}
+
+        def responder(request):
+            feedback = [m for m in request.messages if m["role"] == "tool"]
+            if not feedback:
+                return ModelResponse(
+                    tool_calls=(
+                        ToolCall("echo", {"v": 1}, "call-a"),
+                        ToolCall("echo", {"v": 2}, "call-b"),
+                        ToolCall("echo", {"v": 3}, "call-c"),
+                    )
+                )
+            assistant = [m for m in request.messages if m["role"] == "assistant"][-1]
+            seen_feedback["declared"] = [c["id"] for c in assistant["tool_calls"]]
+            seen_feedback["ids"] = [m["tool_call_id"] for m in feedback]
+            seen_feedback["values"] = [json.loads(m["content"])["result"] for m in feedback]
+            return ModelResponse("all done")
+
+        agent = build(
+            runtime,
+            responder,
+            definition=_tool_definition(),
+            capabilities=CapabilityRegistry(tools=(tool(slow_echo, "echo"),)),
+            execution_policy=ExecutionPolicy(parallel_enabled=True),
+        )
+        result = await (await agent.start("question")).wait(timeout_s=10)
+        assert result.status == "succeeded"
+        # Completion order follows the sleep profile; delivery order does not.
+        assert order == [3, 2, 1], order
+        # One result slot per call id, in the model's own order.
+        assert seen_feedback["ids"] == seen_feedback["declared"]
+        assert len(set(seen_feedback["ids"])) == 3
+        assert seen_feedback["values"] == ["r1", "r2", "r3"]
+
+
+async def test_one_batch_failure_does_not_cancel_sibling_members(build):
+    """requirements.md §3: one failing member never cancels the other parallel members."""
+
+    async def flaky(arguments, context):
+        if arguments.get("v") == 2:
+            raise AgentLoomError("TOOL_BROKEN", category="business")
+        return f"ok{arguments['v']}"
+
+    async with RuntimeEngine() as runtime:
+        statuses = {}
+
+        def responder(request):
+            feedback = [m for m in request.messages if m["role"] == "tool"]
+            if not feedback:
+                return ModelResponse(
+                    tool_calls=(
+                        ToolCall("echo", {"v": 1}, "a"),
+                        ToolCall("echo", {"v": 2}, "b"),
+                        ToolCall("echo", {"v": 3}, "c"),
+                    )
+                )
+            statuses["order"] = [json.loads(m["content"])["status"] for m in feedback]
+            return ModelResponse("handled")
+
+        agent = build(
+            runtime,
+            responder,
+            definition=_tool_definition(),
+            capabilities=CapabilityRegistry(tools=(tool(flaky),)),
+            execution_policy=ExecutionPolicy(parallel_enabled=True),
+        )
+        result = await (await agent.start("q")).wait(timeout_s=10)
+        assert result.status == "succeeded"
+        assert statuses["order"] == ["succeeded", "failed", "succeeded"]
+
+
+async def test_parallel_executors_never_exceed_the_configured_ceiling(build):
+    """runtime.md §5: active + reserved admission stays within executor_max_parallel."""
+    live = {"now": 0, "peak": 0}
+
+    def responder(request):
+        if request.role_key == "planner":
+            if not [m for m in request.messages if m["role"] == "tool"]:
+                return ModelResponse(
+                    tool_calls=tuple(
+                        ToolCall("delegate_task", {"executor": "w", "task": str(i)})
+                        for i in range(4)
+                    )
+                )
+            return ModelResponse("done")
+        return ModelResponse(f"sub-{request.messages[-1]['content']}")
+
+    async def instrumented(inner):
+        return inner
+
+    class Counting:
+        def __init__(self, inner):
+            self.descriptor = inner.descriptor
+            self.inner = inner
+
+        async def stream_once(self, request, context):
+            if request.role_key == "planner":
+                async for frame in self.inner.stream_once(request, context):
+                    yield frame
+                return
+            live["now"] += 1
+            live["peak"] = max(live["peak"], live["now"])
+            try:
+                await asyncio.sleep(0.05)
+                async for frame in self.inner.stream_once(request, context):
+                    yield frame
+            finally:
+                live["now"] -= 1
+
+
+    async with RuntimeEngine() as runtime:
+        agent = build(
+            runtime,
+            None,
+            cls=PlanAgent,
+            executors={"w": AgentDefinition("worker", "SUB", "carries out delegated work")},
+            model=Counting(ScriptedModel(responder)),
+            execution_policy=ExecutionPolicy(parallel_enabled=True, executor_max_parallel=2),
+        )
+        result = await (await agent.start("q")).wait(timeout_s=15)
+        assert result.status == "succeeded"
+        assert live["peak"] <= 2, live
+        run = runtime._load(result.run_id)
+        assert len([t for t in run["tasks"].values() if t["role_key"] == "w"]) == 4
+
+
+# ---------------------------------------------------------------- requirements §5 / event-bus hooks
+
+
+async def test_before_hook_deny_blocks_the_call_without_an_attempt(build):
+    """requirements.md §5: a legal deny takes effect and no external work starts."""
+    from agentloom import FunctionHookHandler, HookBinding, HookDecision, HookSet
+
+    calls = {"n": 0}
+
+    async def hook(event, context):
+        return HookDecision("deny")
+
+    async with RuntimeEngine() as runtime:
