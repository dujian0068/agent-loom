async def test_before_hook_deny_blocks_the_call_without_an_attempt(build):
    """requirements.md §5: a legal deny takes effect and no external work starts."""
    from agentloom import FunctionHookHandler, HookBinding, HookDecision, HookSet

    async def hook(event, context):
        return HookDecision("deny")

    async with RuntimeEngine() as runtime:
        agent = build(
            runtime,
            lambda r: ModelResponse("never"),
            hooks=HookSet(
                bindings=(HookBinding("h1", "model.generate", "request", "denier", ordinal=0),),
                handlers={"denier": FunctionHookHandler(hook)},
            ),
        )
        result = await (await agent.start("q")).wait(timeout_s=10)
        run = runtime._load(result.run_id)
        op = next(iter(run["operations"].values()))
        assert result.status == "failed"
        assert op["status"] == "blocked" and op["attempts"] == []
        assert op["ticket"] is None  # a denied root call never reserves a Loop ticket
        assert len(agent.model.requests) == 0
        assert run["usage"]["loops_consumed"] == 0


async def test_illegal_hook_patch_is_discarded_atomically(build):
    """requirements.md §5 / implementation.md: an invalid patch keeps the original
    effective result and only records a diagnostic."""
    from agentloom import FunctionHookHandler, HookBinding, HookDecision, HookSet

    executed = {}

    async def hook(event, context):
        # v=99 violates the tool's declared input schema.
        return HookDecision("allow", payload_patch={"arguments": {"v": 99}})

    async with RuntimeEngine() as runtime:

        def responder(request):
            return _one_tool_call_then_done(request, "echo", {"v": 1})

        agent = build(
            runtime,
            responder,
            definition=_tool_definition(),
            capabilities=CapabilityRegistry(
                tools=(_constrained_tool(lambda a, c: executed.setdefault("v", a["v"]), "echo"),)
            ),
            hooks=HookSet(
                bindings=(HookBinding("h", "capability.invoke", "request", "patcher"),),
                handlers={"patcher": FunctionHookHandler(hook)},
            ),
        )
        result = await (await agent.start("q")).wait(timeout_s=10)
        assert result.status == "succeeded"
        run = runtime._load(result.run_id)
        tool_ops = [o for o in run["operations"].values() if o["event_type"] == "capability.invoke"]
        hook_state = tool_ops[0]["hooks"]["request:h"]
        assert hook_state["patch_status"] == "rejected"
        assert tool_ops[0]["request"]["arguments"] == {"v": 1}
        # The original, unpatched arguments were actually executed.
        assert executed["v"] == 1
        assert result.status == "succeeded"


async def test_legal_hook_payload_patch_is_the_authoritative_model_input(build):
