                        "executor": "worker",
                        "task": "Find a number"
                        if not feedback
                        else "Previous step failed with EVIDENCE_UNAVAILABLE. Use this supplied fact: 42.",
                    },
                ),
            )
        )

    async with RuntimeEngine(store=runtime_store) as runtime:
        agent = build(
