async def test_history_uses_recent_runs_and_hides_executor_private_records(build):
    """requirements.md §4: only the most recent N finished root processes are replayed."""
    captured = {}

    async def each(runtime, question, answer):
        agent = build(runtime, lambda r: ModelResponse(answer))
        return await (await agent.start(question, session_id="s1")).wait(timeout_s=10)

    async with RuntimeEngine() as runtime:
        await each(runtime, "q1", "a1")
        await each(runtime, "q2", "a2")

        def responder(request):
            captured["text"] = json.dumps(request.messages)
            return ModelResponse("a3")

        agent = build(runtime, responder, context_policy=ContextPolicy(recent_runs=1))
        await (await agent.start("q3", session_id="s1")).wait(timeout_s=10)
        text = captured["text"]
        # The most recent finished run is replayed as its actual root process.
        assert "a2" in text
        # requirements.md §4: older runs keep every user input and the final result,
        # but never their intermediate tool exchange.
        assert "q1" in text and "a1" in text
        assert "assistant" not in text or text.count('"tool"') == 0


